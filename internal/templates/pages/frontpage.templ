package pages

import (
  "github.com/jus4/favorite-boulders/internal/templates/layouts"
  "github.com/jus4/favorite-boulders/internal/model"
)

templ FrontPage(metadata model.Metadata, contents templ.Component) {
  @layouts.Layout(metadata) {
   <div class="bg-white">
     <div id="map" class="relative w-full h-[calc(100vh-48px)] md:h-[100vh] z-10">
      <div class="flex gap-2 md:gap-4 absolute top-0 w-full bg-dark-charkol z-50">
        <button class="p-2 text-white" id="map-zoom-out-btn" aria-label="Suurenna sisään">
          <span class="w-[30px] h-[30px] relative block mr-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 -960 960 960"  fill="#FFFFFF"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400ZM280-540v-80h200v80H280Z"/></svg>
          </span>

        </button>
        <button class="p-2 text-white" id="map-zoom-in-btn" aria-label="Suurenna ulos">
          <span class="w-[30px] h-[30px] relative block mr-1">
            <svg xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960" class="w-full h-full" fill="#FFFFFF"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Zm-40-60v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/></svg>
          </span>
        </button>
        <button class="p-2 text-white flex justify-center items-center" id="user-loc-btn" aria-label="Näytä sijainti">
          <span class="w-[30px] h-[30px] relative block mr-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="w-full h-full" fill="#ffffff"><path d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Zm0-480Z"/></svg>
            </span>
          <div class="hidden md:block">Oma sijainti</div>
        </button>
        <button class="p-2 text-white flex justify-center items-center" id="maastokartta-map-btn" aria-label="Näytä maastokartta" >
            <span class="w-[30px] h-[30px] relative block mr-1">
              <svg xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960" class="w-full h-full" fill="#FFFFFF"><path d="m40-240 240-320 180 240h300L560-586 460-454l-50-66 150-200 360 480H40Zm521-80Zm-361 0h160l-80-107-80 107Zm0 0h160-160Z"/></svg>
            </span>
          <div class="hidden md:block">Maastokartta</div>
        </button>
        <button class="p-2 text-white flex justify-center items-center" id="ortokuva-map-btn" aria-label="Näytä ortokuva" >
            <span class="w-[30px] h-[30px] relative block mr-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="w-full h-full" fill="#FFFFFF"><path d="m140-200-60-60 300-300 160 160 67-76-224-207-243 243-60-60 300-300 284 261 160-181 56 56-158 178 158 146-60 60-154-142-126 142-160-160-240 240Z"/></svg>
            </span>
          <div class="hidden md:block">Ortokuva</div>
        </button>
      </div>
       <div id="popup" class="ol-popup">
         <div id="popup-content"></div>
       </div>

      <div 
         id="sector-info" 
         class="hidden absolute bottom-0 h-2/4 md:h-full w-full md:w-[400px] z-20 bg-dark-charkol right-[0] md:top-0 md:pt-[46px] overflow-hidden"
       >
         <div class="sector-route-list h-full overflow-y-auto"></div>
         <div id="sector-route-info" class="absolute top-0 md:pt-[46px] bg-dark-charkol h-full w-full hidden overflow-y-auto">
          <button id="close-route-info-btn" class="ml-8 mt-4 text-white">Takaisin > </button>
          <div id="sector-route-info-content"></div>
         </div>
      </div>
     </div>
     if contents != nil {
       @contents
     }
   </div>
  }
}
